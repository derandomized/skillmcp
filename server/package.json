{
  "name": "skillmcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server exposing the SkillMCP catalog for browsing from any surface",
  "scripts": {
    "build": "tsc -p . && esbuild ui/browse.src.js --bundle --format=esm --minify --outfile=ui/browse.bundle.js && esbuild test/host.src.js --bundle --format=esm --outfile=test/host.bundle.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "harness": "echo \"open http://127.0.0.1:8790/host.html?server=http://127.0.0.1:8765/mcp\" && (cd test && python3 -m http.server 8790)"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
